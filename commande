// Fonction trigo
float trigo ( int z, int var, float a, float b, float k, float x)
  { 
    float rad, calcul, resultat;
    float kajy = (a*x+b);
    if (z== 0) // calcul en dedre
      {
         calcul=kajy*PI/180;
      }
    else if (z== -1) // calcul en radian
      {
        calcul=kajy;
      }
    if (var== -1) // sin
      {
        resultat=k+sin(calcul);
        printf ("Le resultat est %.2f",resultat);
      }
    else if (var== -3) // tan
      {
        resultat=k+tan(calcul);
        printf ("Le resultat est %.2f",resultat);
      }
    else if (var== -2) // cos
      {
        resultat=k+cos(calcul);
        printf ("Le resultat est %.2f",resultat);
      }
    else if (var== -4) // asin
      {
        resultat=k+asin(calcul);
        printf ("Le resultat est %.2f",resultat);
      }
    else if (var== -6) // atan
      {
        resultat=k+atan(calcul);
        printf ("Le resultat est %.2f",resultat);
      }
    else if (var== -5) // acos
      {
        resultat=k+acos(calcul);
        printf ("Le resultat est %.2f",resultat);
      }
    return (resultat);
  }
  
